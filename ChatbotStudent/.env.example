# ============================================
# EduAI Chatbot Student - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
#
# Cách dùng:
# 1. Copy file này thành .env
# 2. Điền giá trị thực tế vào .env (không có dấu ngoặc kép)
# 3. .env đã được thêm vào .gitignore nên sẽ không bị push lên repo

# ── Database ──────────────────────────────────────────────
# Connection string cho SQL Server
DB_CONNECTION_STRING=Server=localhost;Database=ChatbotDB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true

# ── OpenAI / AI Service ──────────────────────────────────
# API key cho dịch vụ AI (OpenAI, OpenRouter, Gemini...)
OPENAI_API_KEY=your-api-key-here

# ── Email (SMTP) ─────────────────────────────────────────
# Địa chỉ email gửi đi
EMAIL_SENDER=your-email@gmail.com
# Mật khẩu ứng dụng (App Password) cho Gmail
EMAIL_PASSWORD=your-app-password-here
