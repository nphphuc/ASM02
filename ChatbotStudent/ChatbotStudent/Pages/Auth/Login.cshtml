@page
@model ChatbotStudent.Web.Pages.Auth.LoginModel
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - AI Chatbot Sinh Viên</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        :root {
            --primary: #4f46e5;
            --primary-dark: #3730a3;
        }
        body {
            font-family: 'Inter', system-ui, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .auth-card {
            background: #fff;
            border-radius: 20px;
            padding: 2.5rem;
            width: 100%;
            max-width: 420px;
            box-shadow: 0 20px 60px rgba(0,0,0,.15);
        }
        .auth-card .logo {
            text-align: center;
            margin-bottom: 1.5rem;
        }
        .auth-card .logo i {
            font-size: 3rem;
            color: var(--primary);
        }
        .auth-card .logo h3 {
            font-weight: 700;
            margin-top: .5rem;
            color: #1e293b;
        }
        .form-control {
            padding: .75rem 1rem;
            border-radius: 12px;
            border: 2px solid #e2e8f0;
            font-size: .95rem;
            transition: all .2s;
        }
        .form-control:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(79,70,229,.15);
        }
        .btn-primary {
            background: var(--primary);
            border: none;
            border-radius: 12px;
            padding: .75rem;
            font-weight: 600;
            transition: all .2s;
        }
        .btn-primary:hover {
            background: var(--primary-dark);
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(79,70,229,.3);
        }
        .form-label { font-weight: 500; font-size: .9rem; color: #475569; }
        .auth-footer { text-align: center; margin-top: 1.5rem; font-size: .9rem; color: #64748b; }
        .alert { border-radius: 12px; }
    </style>
</head>
<body>
    <div class="auth-card">
        <div class="logo">
            <i class="bi bi-robot"></i>
            <h3>AI Chatbot SV</h3>
            <p class="text-muted">Đăng nhập để tiếp tục</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-danger">@Model.ErrorMessage</div>
        }

        @if (!string.IsNullOrEmpty(Model.SuccessMessage))
        {
            <div class="alert alert-success">@Model.SuccessMessage</div>
        }

        <form method="post">
            <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email" name="email" class="form-control" placeholder="nhap@email.com" required />
            </div>
            <div class="mb-3">
                <label class="form-label">Mật khẩu</label>
                <input type="password" name="password" class="form-control" placeholder="••••••" required />
            </div>
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
            </button>
            <div class="text-center mt-2">
                <a href="/Auth/ForgotPassword" class="text-decoration-none small" style="color:var(--primary)">
                    <i class="bi bi-question-circle me-1"></i>Quên mật khẩu?
                </a>
            </div>
        </form>

        <div class="auth-footer">
            Chưa có tài khoản? <a href="/Auth/Register" class="fw-semibold" style="color:var(--primary)">Đăng ký</a>
        </div>
    </div>
</body>
</html>
