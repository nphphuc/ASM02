@page
@model ChatbotStudent.Web.Pages.Admin.CoursesModel
@{
    ViewData["Title"] = "Quản lý môn học";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0"><i class="bi bi-book me-2"></i>Quản lý môn học</h4>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createCourseModal">
            <i class="bi bi-plus-circle me-1"></i> Tạo môn học
        </button>
    </div>

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show">
            @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        @foreach (var course in Model.Courses)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="fw-bold mb-0">@course.Name</h5>
                            <span class="badge bg-primary">@course.Code</span>
                        </div>
                        <p class="text-muted small mb-2">@(course.Description?.Length > 120 ? course.Description[..120] + "..." : course.Description)</p>
                        <div class="d-flex justify-content-between text-muted small mb-2">
                            <span><i class="bi bi-people me-1"></i> @course.Enrollments.Count SV</span>
                            <span><i class="bi bi-file-earmark me-1"></i> @course.Documents.Count tài liệu</span>
                        </div>
                        <div class="d-flex align-items-center gap-2 mb-3">
                            @if (course.Lecturer != null)
                            {
                                <span class="badge bg-info text-dark">
                                    <i class="bi bi-person-badge me-1"></i>@course.Lecturer.FullName
                                </span>
                            }
                            else
                            {
                                <span class="text-muted small"><i class="bi bi-dash-circle me-1"></i>Chưa có giảng viên</span>
                            }
                            <button class="btn btn-sm btn-outline-secondary ms-auto"
                                    data-bs-toggle="modal" data-bs-target="#assignLecturerModal"
                                    data-course-id="@course.Id"
                                    data-course-name="@course.Name"
                                    data-lecturer-id="@(course.LecturerId?.ToString() ?? "")">
                                <i class="bi bi-person-fill-gear"></i>
                            </button>
                        </div>
                        <div class="d-flex gap-2">
                            <a href="/Admin/CourseDetail?courseId=@course.Id" class="btn btn-outline-primary btn-sm flex-grow-1">
                                <i class="bi bi-gear me-1"></i> Quản lý
                            </a>
                            <form method="post" asp-page-handler="DeleteCourse" 
                                  onsubmit="return confirm('Xóa môn học @course.Name? Toàn bộ dữ liệu liên quan sẽ bị xóa.')">
                                <input type="hidden" name="courseId" value="@course.Id" />
                                <button type="submit" class="btn btn-outline-danger btn-sm">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Courses.Any())
    {
        <div class="text-center p-5 text-muted">
            <i class="bi bi-book fs-1 d-block mb-2"></i>
            <p>Chưa có môn học nào.</p>
        </div>
    }
</div>

<!-- Assign Lecturer Modal -->
<div class="modal fade" id="assignLecturerModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="AssignLecturer">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-person-fill-gear me-2"></i>Gán giảng viên</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="courseId" id="assignCourseId" />
                    <p class="mb-3" id="assignCourseName"></p>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Giảng viên phụ trách</label>
                        <select name="lecturerId" class="form-select" id="assignLecturerSelect">
                            <option value="">-- Không có giảng viên (gỡ) --</option>
                            @foreach (var lecturer in Model.Lecturers)
                            {
                                <option value="@lecturer.Id">@lecturer.FullName (@lecturer.Email)</option>
                            }
                        </select>
                        <div class="form-text">Chọn "Không có giảng viên" để gỡ giảng viên hiện tại.</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> Lưu</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Assign Lecturer modal: populate course info + current lecturer
        document.getElementById('assignLecturerModal').addEventListener('show.bs.modal', function (e) {
            var btn = e.relatedTarget;
            var courseId = btn.getAttribute('data-course-id');
            var courseName = btn.getAttribute('data-course-name');
            var lecturerId = btn.getAttribute('data-lecturer-id');

            document.getElementById('assignCourseId').value = courseId;
            document.getElementById('assignCourseName').innerHTML = '<strong>' + courseName + '</strong>';
            document.getElementById('assignLecturerSelect').value = lecturerId || '';
        });
    </script>
}

<!-- Create Course Modal -->
<div class="modal fade" id="createCourseModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="CreateCourse">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-plus-circle me-2"></i>Tạo môn học mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên môn học</label>
                        <input type="text" name="name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mã môn học</label>
                        <input type="text" name="code" class="form-control" placeholder="VD: AI101" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Mô tả</label>
                        <textarea name="description" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Giảng viên phụ trách</label>
                        <select name="lecturerId" class="form-select">
                            <option value="">-- Chọn --</option>
                            @foreach (var lecturer in Model.Lecturers)
                            {
                                <option value="@lecturer.Id">@lecturer.FullName (@lecturer.Email)</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i> Tạo</button>
                </div>
            </form>
        </div>
    </div>
</div>
